7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"local a,b=1.7,0.7\r\nself.ang_bx=sign==1 and 36+basea0 or 144+basea0\r\nself.basis1={cos(self.ang_bx)*a,sin(self.ang_bx)*a}\r\nself.basis2={-sin(self.ang_bx)*b,cos(self.ang_bx)*b}\r\nself.cx,self.cy=tar.x,tar.y\r\nlocal arg=sign==1 and 36+a0 or 144+a0\r\nlocal r0=35+ran:Float(-4,4)\r\nself.x,self.y=self.cx+r0*(self.basis1[1]*cos(arg)+self.basis2[1]*sin(arg)),\r\n\t\t\t\tself.cy+r0*(self.basis1[2]*cos(arg)+self.basis2[2]*sin(arg))\r\nself.tar=tar\r\nself.co=co\r\nself.colli=false\r\nself.bound=false","EditWindow":"code"}],"AttributeCount":1}
