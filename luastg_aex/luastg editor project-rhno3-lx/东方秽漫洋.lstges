7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"local template={}\r\nfor i=1,#self.objs do\r\n\ttemplate[i]=i\r\nend","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.Repeat, LuaSTGEditorSharp","Attributes":[{"attrCap":"Times","attrInput":"#self.objs","EditWindow":"yield"},{"$type":".DependencyAttrItem, ","attrCap":"Number of Var","attrInput":"1","EditWindow":""},{"attrCap":"Var 1 name","attrInput":"i","EditWindow":""},{"attrCap":"Var 1 init value","attrInput":"1","EditWindow":""},{"attrCap":"Var 1 increment","attrInput":"1","EditWindow":""}],"AttributeCount":5}
8,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"local mindist=1000\r\nlocal index=ran:Int(1,#self.objs)","EditWindow":"code"}],"AttributeCount":1}
8,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"local region=difference(template,neighbor[i])\r\nfor k,v in ipairs(region) do\r\n\tprint(v)\r\nend\r\n--local region=template\r\nfor k,v in ipairs(region) do\r\n\tlocal bonus=0\r\n\tif (#neighbor[v]>=2 and #neighbor[v]<=3) then bonus=0.16*rmax end\r\n\tif v~=i then \r\n\t    local d=Dist(self.objs[v],self.objs[i])\r\n\t    --print(\"v,i:\"..self.objs[v].x..\",\"..self.objs[v].y..\",\"..self.objs[i].x..\",\"..self.objs[i].y)\r\n\t    --print(\"index,i,v,d,mindist=\"..index..\" \"..i..\" \"..v..\" \"..d..\" \"..mindist)\r\n\t    --local p_forget=1-(mindist-d+bonus)/mindist*2.5\r\n\t    local p_forget=0\r\n\t    if d+bonus<mindist then\r\n\t        mindist=d+bonus\r\n\t        index=v\r\n\t    end\r\n\tend\r\nend","EditWindow":"code"}],"AttributeCount":1}
