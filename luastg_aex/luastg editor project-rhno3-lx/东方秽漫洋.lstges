4,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"-- 添加Ending关卡到Normal组          \r\nstage.group.AddStage('Normal', 'Ending@Normal', {lifeleft=2, power=0, faith=50000, bomb=0}, true)    \r\n\r\nlocal function BlockPlayer()\r\n    \tplayer.lock=true\r\n    \trenseki_player.ChangeColor(player,0,0,0,0)\r\n    \tplayer.x=0\r\n    \tplayer.y=-300\r\n    \tlstg.var.MinPower=0\r\n    \tlstg.var.power=0\r\n    \tlstg.var.ShowBackground=false\r\n    \tlstg.var.ShowBomb=false\r\n    \tlstg.var.ShowPower=false\r\n    \tlstg.var.ShowLife=false\r\n    \tlstg.var.block_spell=true\r\n\t\tlstg.var.block_shoot=true\r\nend\r\n          \r\n-- 定义Ending关卡的init函数          \r\nstage.group.DefStageFunc('Ending@Normal', 'init', function(self)          \r\n    _init_item(self)          \r\n    difficulty = self.group.difficulty          \r\n    New(mask_fader, 'open')          \r\n    -- 创建玩家      \r\n    --if jstg then jstg.CreatePlayers() else New(_G[lstg.var.player_name]) end          \r\n\t--player.lock=false\r\n\tlstg.var.block_spell=true\r\n\tlstg.var.block_shoot=true\r\n\tlstg.var.ShowBomb=false\r\n\tlstg.var.ShowPower=false\r\n\tlstg.var.ShowLife=false\r\n\tlstg.var.ShowBackground=true\r\n\tSetWorldV2(0,0,640,480,640,900)\r\n    -- 加载字体          \r\n    LoadTTF('ending_font', 'assets/font/SourceHanSansCN-Bold.otf', 24, 24)          \r\n              \r\n    -- 播放ending音乐          \r\n    LoadMusic(\"bgm_ending(no loop)\", \"THlib/music/星涟心迹 ~ Starlit Cognition(no loop).ogg\",0,0)          \r\n    SetBGMLoop(\"bgm_ending(no loop)\", false)          \r\n    LoadMusicRecord(\"bgm_ending(no loop)\")          \r\n    _play_music(\"bgm_ending(no loop)\")          \r\n          \r\n    -- 读取文本文件          \r\n    self.ending_text = {}          \r\n    local file_content = lstg.LoadTextFile('assets/text/ending.txt')          \r\n    if file_content then          \r\n        for line in file_content:gmatch(\"[^\\r\\n]+\") do          \r\n            table.insert(self.ending_text, line)          \r\n        end          \r\n    end      \r\n          \r\n    -- 如果文件为空，添加默认文本      \r\n    if #self.ending_text == 0 then      \r\n        self.ending_text = {'', '文本文件未找到或为空', ''}      \r\n    end      \r\n                  \r\n    -- 文本显示参数（优化间距）      \r\n    self.margin_left = 60            \r\n    self.margin_right = 60           \r\n    self.margin_top = 60             \r\n    self.margin_bottom = 60          \r\n    self.line_height = 35      -- 适中的行高      \r\n        \r\n    -- 计算可用屏幕空间和最大行数    \r\n    self.available_height = 480 - self.margin_top - self.margin_bottom    \r\n    self.max_lines_per_page = math.floor(self.available_height / self.line_height)    \r\n        \r\n    self.current_page = 0          \r\n    self.total_pages = math.ceil(#self.ending_text / self.max_lines_per_page)          \r\n          \r\n    -- 计算文本显示区域      \r\n    self.text_left = self.margin_left      \r\n    self.text_right = 640 - self.margin_right      \r\n    self.text_top = 480 - self.margin_top        \r\n    self.text_bottom = self.margin_bottom      \r\n          \r\n    -- 文本显示状态      \r\n    self.lines_shown_in_page = 0      \r\n    self.line_timer = 0      \r\n    self.line_interval = 110      \r\n    self.is_displaying_page = false      \r\n    self.waiting_for_input = false      \r\n    self.line_alphas = {}  \r\n    self.last_page_complete = false  -- 新增：标记最后一页是否显示完成        \r\n    -- 使用stage.group.initTask来管理任务\r\n    stage.group.initTask(self, function()   \r\n    \tBlockPlayer()\r\n        -- 等待所有文本显示完成      \r\n        while not self.last_page_complete do      \r\n            task.Wait(1)      \r\n        end      \r\n              \r\n        -- 等待音乐播放完成\r\n        local x = 0\r\n        --[[\r\n        while GetMusicState('bgm_ending(no loop)') == 'playing' do          \r\n            task.Wait(60)\r\n            print(x)\r\n            x = x+1\r\n            if(x == 29) then break end\r\n        end          \r\n        --]]\r\n        task.Wait(90)\r\n        -- 退出关卡          \r\n\t    task.New(self,function()\r\n\t        while coroutine.status(self.task[1])~='dead' do task.Wait() end\r\n\t        stage.group.FinishReplay()\r\n\t        New(mask_fader,'close')\r\n\t        task.New(self,function()\r\n\t            local _,bgm=EnumRes('bgm')\r\n\t            for i=1,90 do\r\n\t                for _,v in pairs(bgm) do\r\n\t                    if GetMusicState(v)=='playing' then\r\n\t                        SetBGMVolume(v,1-i/90)\r\n\t                    end\r\n\t                end\r\n\t                task.Wait()\r\n\t            end\r\n\t        end)\r\n\t        task.Wait(30)\r\n\t        stage.group.FinishStage()\r\n\t    end)\r\n    end)          \r\nend)      \r\n      \r\n-- frame函数      \r\nstage.group.DefStageFunc('Ending@Normal', 'frame', function(self)      \r\n    if self.current_page >= self.total_pages then      \r\n        return      \r\n    end      \r\n          \r\n    -- 如果正在等待翻页输入      \r\n    if self.waiting_for_input then        \r\n            self.waiting_for_input = false      \r\n            self.current_page = self.current_page + 1      \r\n            self.lines_shown_in_page = 0      \r\n            self.line_timer = 0      \r\n            self.is_displaying_page = false      \r\n            -- 清空透明度数组      \r\n            self.line_alphas = {}      \r\n        return      \r\n    end      \r\n          \r\n    -- 如果正在显示页面      \r\n    if self.is_displaying_page then      \r\n        self.line_timer = self.line_timer + 1      \r\n              \r\n        -- 检查是否显示下一行      \r\n        if self.line_timer >= self.line_interval then      \r\n            local start_idx = self.current_page * self.max_lines_per_page + 1      \r\n            local end_idx = math.min(start_idx + self.max_lines_per_page - 1, #self.ending_text)      \r\n                  \r\n            if self.lines_shown_in_page < end_idx - start_idx + 1 then      \r\n                self.lines_shown_in_page = self.lines_shown_in_page + 1      \r\n                self.line_timer = 0      \r\n                self.line_alphas[self.lines_shown_in_page] = 0  -- 新行初始透明度      \r\n            else      \r\n                -- 当前页显示完成  \r\n                if self.current_page < self.total_pages - 1 then      \r\n                    -- 不是最后一页，等待翻页      \r\n                    self.waiting_for_input = true      \r\n                else      \r\n                    -- 最后一页显示完成，标记完成但不退出  \r\n                    self.last_page_complete = true      \r\n                end      \r\n            end      \r\n        end      \r\n    else      \r\n        -- 开始显示新页面      \r\n        self.is_displaying_page = true      \r\n    end      \r\n          \r\n    -- 更新每行的透明度（淡入效果）      \r\n    for i = 1, self.lines_shown_in_page do        \r\n        if self.line_alphas[i] and self.line_alphas[i] < 255 then        \r\n            self.line_alphas[i] = math.min(255, self.line_alphas[i] + 255 / 20)        \r\n        end        \r\n    end      \r\nend)      \r\n      \r\n-- render函数      \r\nstage.group.DefStageFunc('Ending@Normal', 'render', function(self)   \r\n\tSetViewMode(\"ui\")\r\n\tSetImageState('image:transfer', 'mul+alpha', lstg.Color(155, 65, 130, 160))\r\n\tlocal cx,cy=320,240\r\n\tlocal dy=100\r\n\tlocal dx=270\r\n\tRender('image:transfer', cx, cy,0,0.25,0.25)\r\n    -- 修改：在最后一页完成后继续显示文本  \r\n    if (self.current_page < self.total_pages or self.last_page_complete) and #self.ending_text > 0 then      \r\n        local start_idx = self.current_page * self.max_lines_per_page + 1      \r\n        local end_idx = math.min(start_idx + self.max_lines_per_page - 1, #self.ending_text)      \r\n              \r\n        for i = 0, self.lines_shown_in_page - 1 do      \r\n            if start_idx + i <= end_idx then      \r\n                local line_idx = i      \r\n                local alpha = self.line_alphas[i + 1] or 255      \r\n                      \r\n                -- 计算当前行的Y位置（从上到下显示）      \r\n                local current_y = self.text_top - line_idx * self.line_height      \r\n                      \r\n                -- 确保不超出屏幕底部      \r\n                if current_y - self.line_height >= self.text_bottom then      \r\n                    RenderTTF(\"ending_font\",      \r\n                        self.ending_text[start_idx + i],      \r\n                        self.text_left,      \r\n                        self.text_right,      \r\n                        current_y - self.line_height,  -- bottom（较小Y值）      \r\n                        current_y,                     -- top（较大Y值）      \r\n                        Color(alpha, 255, 255, 255),      \r\n                        \"left\", \"vcenter\", \"wordbreak\", \"noclip\")        \r\n                end      \r\n            end      \r\n        end      \r\n    end      \r\n          \r\n    SetViewMode 'world'      \r\nend)","EditWindow":"code"}],"AttributeCount":1,"IsExpanded":false}
2,{"$type":".Stage.StageGroup, ","Attributes":[{"attrCap":"Name","attrInput":"Normal","EditWindow":"stageGroup"},{"attrCap":"Start life","attrInput":"3","EditWindow":""},{"attrCap":"Start power","attrInput":"0","EditWindow":""},{"attrCap":"Start faith","attrInput":"50000","EditWindow":""},{"attrCap":"Start bomb","attrInput":"0","EditWindow":""},{"attrCap":"Allow practice","attrInput":"true","EditWindow":"bool"},{"attrCap":"Difficulty value","attrInput":"1","EditWindow":"difficulty"}],"AttributeCount":7}
3,{"$type":".General.Comment, LuaSTGEditorSharp","Attributes":[{"attrCap":"Comment","attrInput":"ending","EditWindow":""},{"attrCap":"Comment on child","attrInput":"false","EditWindow":"bool"}],"AttributeCount":2,"IsExpanded":false,"IsBanned":true}
4,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"-- 添加Ending关卡到Normal组          \r\nstage.group.AddStage('Normal', 'Ending@Normal', {lifeleft=2, power=0, faith=50000, bomb=0}, true)    \r\n\r\nlocal function BlockPlayer()\r\n    \tplayer.lock=true\r\n    \trenseki_player.ChangeColor(player,0,0,0,0)\r\n    \tplayer.x=0\r\n    \tplayer.y=-300\r\n    \tlstg.var.MinPower=0\r\n    \tlstg.var.power=0\r\n    \tlstg.var.ShowBackground=false\r\n    \tlstg.var.ShowBomb=false\r\n    \tlstg.var.ShowPower=false\r\n    \tlstg.var.ShowLife=false\r\n    \tlstg.var.block_spell=true\r\n\t\tlstg.var.block_shoot=true\r\nend\r\n          \r\n-- 定义Ending关卡的init函数          \r\nstage.group.DefStageFunc('Ending@Normal', 'init', function(self)          \r\n    _init_item(self)          \r\n    difficulty = self.group.difficulty          \r\n    New(mask_fader, 'open')          \r\n    -- 创建玩家      \r\n    --if jstg then jstg.CreatePlayers() else New(_G[lstg.var.player_name]) end          \r\n\t--player.lock=false\r\n\tlstg.var.block_spell=true\r\n\tlstg.var.block_shoot=true\r\n\tlstg.var.ShowBomb=false\r\n\tlstg.var.ShowPower=false\r\n\tlstg.var.ShowLife=false\r\n\tlstg.var.ShowBackground=true\r\n\tSetWorldV2(0,0,640,480,640,900)\r\n    -- 加载字体          \r\n    LoadTTF('ending_font', 'assets/font/SourceHanSansCN-Bold.otf', 24, 24)          \r\n              \r\n    -- 播放ending音乐          \r\n    LoadMusic(\"bgm_ending(no loop)\", \"THlib/music/星涟心迹 ~ Starlit Cognition(no loop).ogg\",0,0)          \r\n    SetBGMLoop(\"bgm_ending(no loop)\", false)          \r\n    LoadMusicRecord(\"bgm_ending(no loop)\")          \r\n    _play_music(\"bgm_ending(no loop)\")          \r\n          \r\n    -- 读取文本文件          \r\n    self.ending_text = {}          \r\n    local file_content = lstg.LoadTextFile('assets/text/ending.txt')          \r\n    if file_content then          \r\n        for line in file_content:gmatch(\"[^\\r\\n]+\") do          \r\n            table.insert(self.ending_text, line)          \r\n        end          \r\n    end      \r\n          \r\n    -- 如果文件为空，添加默认文本      \r\n    if #self.ending_text == 0 then      \r\n        self.ending_text = {'', '文本文件未找到或为空', ''}      \r\n    end      \r\n                  \r\n    -- 文本显示参数（优化间距）      \r\n    self.margin_left = 60            \r\n    self.margin_right = 60           \r\n    self.margin_top = 60             \r\n    self.margin_bottom = 60          \r\n    self.line_height = 35      -- 适中的行高      \r\n        \r\n    -- 计算可用屏幕空间和最大行数    \r\n    self.available_height = 480 - self.margin_top - self.margin_bottom    \r\n    self.max_lines_per_page = math.floor(self.available_height / self.line_height)    \r\n        \r\n    self.current_page = 0          \r\n    self.total_pages = math.ceil(#self.ending_text / self.max_lines_per_page)          \r\n          \r\n    -- 计算文本显示区域      \r\n    self.text_left = self.margin_left      \r\n    self.text_right = 640 - self.margin_right      \r\n    self.text_top = 480 - self.margin_top        \r\n    self.text_bottom = self.margin_bottom      \r\n          \r\n    -- 文本显示状态      \r\n    self.lines_shown_in_page = 0      \r\n    self.line_timer = 0      \r\n    self.line_interval = 110      \r\n    self.is_displaying_page = false      \r\n    self.waiting_for_input = false      \r\n    self.line_alphas = {}  \r\n    self.last_page_complete = false  -- 新增：标记最后一页是否显示完成        \r\n    -- 使用stage.group.initTask来管理任务\r\n    stage.group.initTask(self, function()   \r\n    \tBlockPlayer()\r\n        -- 等待所有文本显示完成      \r\n        while not self.last_page_complete do      \r\n            task.Wait(1)      \r\n        end      \r\n              \r\n        -- 等待音乐播放完成\r\n        local x = 0\r\n        --[[\r\n        while GetMusicState('bgm_ending(no loop)') == 'playing' do          \r\n            task.Wait(60)\r\n            print(x)\r\n            x = x+1\r\n            if(x == 29) then break end\r\n        end          \r\n        --]]\r\n        task.Wait(90)\r\n        -- 退出关卡          \r\n\t    task.New(self,function()\r\n\t        while coroutine.status(self.task[1])~='dead' do task.Wait() end\r\n\t        stage.group.FinishReplay()\r\n\t        New(mask_fader,'close')\r\n\t        task.New(self,function()\r\n\t            local _,bgm=EnumRes('bgm')\r\n\t            for i=1,90 do\r\n\t                for _,v in pairs(bgm) do\r\n\t                    if GetMusicState(v)=='playing' then\r\n\t                        SetBGMVolume(v,1-i/90)\r\n\t                    end\r\n\t                end\r\n\t                task.Wait()\r\n\t            end\r\n\t        end)\r\n\t        task.Wait(30)\r\n\t        stage.group.FinishStage()\r\n\t    end)\r\n    end)          \r\nend)      \r\n      \r\n-- frame函数      \r\nstage.group.DefStageFunc('Ending@Normal', 'frame', function(self)      \r\n    if self.current_page >= self.total_pages then      \r\n        return      \r\n    end      \r\n          \r\n    -- 如果正在等待翻页输入      \r\n    if self.waiting_for_input then        \r\n            self.waiting_for_input = false      \r\n            self.current_page = self.current_page + 1      \r\n            self.lines_shown_in_page = 0      \r\n            self.line_timer = 0      \r\n            self.is_displaying_page = false      \r\n            -- 清空透明度数组      \r\n            self.line_alphas = {}      \r\n        return      \r\n    end      \r\n          \r\n    -- 如果正在显示页面      \r\n    if self.is_displaying_page then      \r\n        self.line_timer = self.line_timer + 1      \r\n              \r\n        -- 检查是否显示下一行      \r\n        if self.line_timer >= self.line_interval then      \r\n            local start_idx = self.current_page * self.max_lines_per_page + 1      \r\n            local end_idx = math.min(start_idx + self.max_lines_per_page - 1, #self.ending_text)      \r\n                  \r\n            if self.lines_shown_in_page < end_idx - start_idx + 1 then      \r\n                self.lines_shown_in_page = self.lines_shown_in_page + 1      \r\n                self.line_timer = 0      \r\n                self.line_alphas[self.lines_shown_in_page] = 0  -- 新行初始透明度      \r\n            else      \r\n                -- 当前页显示完成  \r\n                if self.current_page < self.total_pages - 1 then      \r\n                    -- 不是最后一页，等待翻页      \r\n                    self.waiting_for_input = true      \r\n                else      \r\n                    -- 最后一页显示完成，标记完成但不退出  \r\n                    self.last_page_complete = true      \r\n                end      \r\n            end      \r\n        end      \r\n    else      \r\n        -- 开始显示新页面      \r\n        self.is_displaying_page = true      \r\n    end      \r\n          \r\n    -- 更新每行的透明度（淡入效果）      \r\n    for i = 1, self.lines_shown_in_page do        \r\n        if self.line_alphas[i] and self.line_alphas[i] < 255 then        \r\n            self.line_alphas[i] = math.min(255, self.line_alphas[i] + 255 / 20)        \r\n        end        \r\n    end      \r\nend)      \r\n      \r\n-- render函数      \r\nstage.group.DefStageFunc('Ending@Normal', 'render', function(self)   \r\n\tSetViewMode(\"ui\")\r\n\tSetImageState('image:transfer', 'mul+alpha', lstg.Color(155, 65, 130, 160))\r\n\tlocal cx,cy=320,240\r\n\tlocal dy=100\r\n\tlocal dx=270\r\n\tRender('image:transfer', cx, cy,0,0.25,0.25)\r\n    -- 修改：在最后一页完成后继续显示文本  \r\n    if (self.current_page < self.total_pages or self.last_page_complete) and #self.ending_text > 0 then      \r\n        local start_idx = self.current_page * self.max_lines_per_page + 1      \r\n        local end_idx = math.min(start_idx + self.max_lines_per_page - 1, #self.ending_text)      \r\n              \r\n        for i = 0, self.lines_shown_in_page - 1 do      \r\n            if start_idx + i <= end_idx then      \r\n                local line_idx = i      \r\n                local alpha = self.line_alphas[i + 1] or 255      \r\n                      \r\n                -- 计算当前行的Y位置（从上到下显示）      \r\n                local current_y = self.text_top - line_idx * self.line_height      \r\n                      \r\n                -- 确保不超出屏幕底部      \r\n                if current_y - self.line_height >= self.text_bottom then      \r\n                    RenderTTF(\"ending_font\",      \r\n                        self.ending_text[start_idx + i],      \r\n                        self.text_left,      \r\n                        self.text_right,      \r\n                        current_y - self.line_height,  -- bottom（较小Y值）      \r\n                        current_y,                     -- top（较大Y值）      \r\n                        Color(alpha, 255, 255, 255),      \r\n                        \"left\", \"vcenter\", \"wordbreak\", \"noclip\")        \r\n                end      \r\n            end      \r\n        end      \r\n    end      \r\n          \r\n    SetViewMode 'world'      \r\nend)","EditWindow":"code"}],"AttributeCount":1,"IsExpanded":false}
