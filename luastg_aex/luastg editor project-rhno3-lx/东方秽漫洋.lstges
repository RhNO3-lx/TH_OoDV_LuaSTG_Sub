5,{"$type":".Audio.PlaySE, ","Attributes":[{"attrCap":"Name","attrInput":"\"alert\"","EditWindow":"se"},{"attrCap":"Volume","attrInput":"1","EditWindow":""},{"attrCap":"Pan","attrInput":"self.x/256","EditWindow":""},{"attrCap":"Ignore default volume","attrInput":"true","EditWindow":"bool"}],"AttributeCount":4}
