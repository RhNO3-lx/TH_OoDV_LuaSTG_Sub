5,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.gx = 0\r\nself.gy = 0\r\nwhile object.status ~= \"kill\" do\r\n\tlstg.player.gx = lstg.player.gx - self.gx\r\n\tlstg.player.gy = lstg.player.gy - self.gy\r\n\tlocal dis = lstg.Dist(lstg.player, self)\r\n\tif lstg.player.protect == 0 and dis < lstg.player.gravity_circle_size then\r\n\t\tself.gx = (self.x-lstg.player.x)/dis*self.gravity\r\n\t\tself.gy = (self.y-lstg.player.y)/dis*self.gravity\r\n\telse\r\n\t\tself.gx = 0\r\n\t\tself.gy = 0\r\n\tend\r\n\tlstg.player.gx = lstg.player.gx + self.gx\r\n\tlstg.player.gy = lstg.player.gy + self.gy\r\n\ttask._Wait(1)\r\nend","EditWindow":"code"}],"AttributeCount":1,"IsExpanded":false,"IsBanned":true}
