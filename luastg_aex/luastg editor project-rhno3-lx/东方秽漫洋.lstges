6,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"dialog=New(DialogDisplayer,{\r\n{text=\"哇哦……里面居然还有这么神奇的东西？\\n那个让我有异样感觉的东西，应该就是这个看起来十分奇怪的几何体了\",func=function(obj)\r\ndial:AddChara(obj,\"renseki\",\"image:renseki-think\",{x=100,y=200},0.25)\r\nend},\r\n{text=\"这玩意怎么有那种熟悉的令人发指的气息？\\n\"},\r\n{text=\"……哦，他居然在用“代码”，然后试图用这玩意来编写某种逻辑，\\n再用自己某种独特的能力把它包装成这样一个能运作的实体？\\n让我来看看他在试图干什么\"},\r\n\r\n{text=\"嗯……这个用户给出的代码看样子像是某种信息自动化处理系统\\n用户试图用一系列带标注的数据，训练一个神经网络把所谓的“污秽”区分开？\\n不过什么是“污秽”来着？\",func=function(obj)\r\ndial:AddChara(obj,\"renseki\",\"image:renseki-think2\",{x=100,y=200},0.25)\r\nend},\r\n{text=\"我得先去了解什么是污秽，所以需要去看这个训练过程的损失函数\\n啊，找到了，但是为什么只是在看语义的重复程度？\\n这貌似和“东方”世界观里的污秽关系不太大\\n啊？什么？这么草率的玩意是月之都那帮子人指定的标准？\"},\r\n\r\n{text=\"而且这貌似还有某种更加奇妙的风格\\n哦我明白了，这是外面那群人熟练使用的vibe coding\\n我说怎么看着像那么回事，但一点工程意识都没有\",func=function(obj)\r\ndial:AddChara(obj,\"renseki\",\"image:renseki-wordless\",{x=100,y=200},0.25)\r\nend},\r\n{text=\"好吧，我大概明白了\\n这玩意是一个急着赶ddl的家伙，为了快速出能展示的成果，应付某种要求\\n随手糊出来的一坨能跑但随之都会散架的东西\"},\r\n{text=\"这坨史山快把我气得原形毕露了！\",func=function(obj)\r\ndial:AddChara(obj,\"renseki\",\"image:renseki-angry\",{x=100,y=200},0.25)\r\nend},\r\n{text=\"好吧，来干正事，我尝试找找这些被我忘掉的东西吧\\n让我和这玩意交互一下\",func=function(obj)\r\ndial:AddChara(obj,\"renseki\",\"image:renseki-smile\",{x=100,y=200},0.25)\r\nend},\r\n{text=\"诶他要干什么？\",CanSkip=false,lifetime=30,func=function(obj)\r\ndial:AddChara(obj,\"renseki\",\"image:renseki-think2\",{x=100,y=200},0.25)\r\ntask.New(player,function()\r\n\ttask.Wait(30)\r\n\tfor i=1,6 do\r\n\t\ttask.Wait(7)\r\n\t\tPlaySound(\"option\",0.1,self.x/256,false)\r\n\t\tNew(_editor_class[\"s4final-eff\"],player.x,player.y,0,0)\r\n\tend\r\n\tstage4b_bg.ChangeTetraColor(bg,\"red\")\r\nend)\r\nend}\r\n})","EditWindow":"code"}],"AttributeCount":1}
