7,{"$type":".General.Comment, LuaSTGEditorSharp","Attributes":[{"attrCap":"Comment","attrInput":"dialog","EditWindow":""},{"attrCap":"Comment on child","attrInput":"false","EditWindow":"bool"}],"AttributeCount":2,"IsExpanded":false}
8,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"local boss=self\r\n\r\nlocal dialog=New(DialogDisplayer,{\r\n{text=\"呼……似乎有种异样但很舒服的感觉\\n有好多想知道的东西以及好多想做的事\",\r\nfunc=function(obj)\r\ndial:AddChara(obj,\"renseki\",\"image:renseki_stand\",{x=100,y=200},0.25)\r\nend},\r\n{text=\"虽然还是感觉心里仿佛缺了块东西一样，\\n在刚才那么多信息的残骸里都没能找到的，重要的东西\",\r\nfunc=function(obj)\r\ndial:RemoveChara(obj,\"renseki\")\r\ndial:AddChara(obj,\"renseki\",\"image:renseki_black\",{x=100,y=200},0.25)\r\nend},\r\n{\r\ntext=\"嗯？那个奇怪的东西是？\",\r\nfunc=function(obj)\r\n\ttask.New(boss,function()\r\n\t\ttask.MoveTo(fx,fy,180,MOVE_ACC_DEC)\r\n\tend)\r\n\tdial:RemoveChara(obj,\"renseki\")\r\n\tdial:AddChara(obj,\"renseki\",\"image:renseki_stand\",{x=100,y=200},0.25)\r\nend\r\n},\r\n{text=\"这家伙是什么……感觉……有些危险……\\n不过他携带的某些信息让我有某种很熟悉的感觉\\n仿佛正是那些“重要的东西”\"},\r\n{text=\"诶？他要……？\"}\r\n})","EditWindow":"code"}],"AttributeCount":1}
