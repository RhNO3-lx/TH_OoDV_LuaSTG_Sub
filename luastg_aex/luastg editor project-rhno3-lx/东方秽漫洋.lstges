7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"local tx,ty=350,ran:Float(-120,220)\r\nlocal route={90,ran:Float(-70,-30)*ran:Sign()+65,\r\n\t\t\t-150+ran:Float(-40,40),70+ran:Float(-160,-120)*ran:Sign(),\r\n\t\t\t-400,20}\r\nif sign==-1 then \r\n\ttx=-tx \r\n\troute={-90+ran:Float(-40,40),ran:Float(-90,160),\r\n\t\t130+ran:Float(-80,80),70+ran:Float(-170,-120)*ran:Sign(),\r\n\t\t400,40+ran:Float(-100,-70)*ran:Sign()}\r\nend\r\n\r\nself.x,self.y=tx,ty","EditWindow":"code"}],"AttributeCount":1}
