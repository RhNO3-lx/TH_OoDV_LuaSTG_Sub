4,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"--self.gravity = gravity\r\nself.sz=EnemySizeTable[size]\r\n\r\nself.EatPowerBonus=size*2\r\nself.EatLifePenality=25\r\nself.EatLightBonus=self.sz*1.3+25\r\n\r\nlocal sc=self.sz/20 ---根据图片中物体的实际大小来决定\r\nself.hscale=sc\r\nself.vscale=sc\r\nself.a=self.sz\r\nself.b=self.sz\r\nself.navi=true\r\nself.rot=ran:Float(0,360)\r\n\r\nself.LightRange=self.sz*2.2\r\n\r\nself.co=FishColor.Red\r\nself.eaten=true\r\n\r\nself.eatflag=false","EditWindow":"code"}],"AttributeCount":1}
