9,{"$type":".General.IfElse, LuaSTGEditorSharp","Attributes":[]}
8,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"local lambda=0.5*(1-cos(180*l))\r\n\r\nlocal r=ori_r*(1-lambda)+dest_r*lambda\r\nlocal a=ori_a*(1-lambda)+dest_a*lambda\r\nself.x,self.y=self.p.x+r*cos(a),self.p.y+r*sin(a)","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.Repeat, LuaSTGEditorSharp","Attributes":[{"attrCap":"Times","attrInput":"90","EditWindow":"yield"},{"$type":".DependencyAttrItem, ","attrCap":"Number of Var","attrInput":"1","EditWindow":""},{"attrCap":"Var 1 name","attrInput":"aa","EditWindow":""},{"attrCap":"Var 1 init value","attrInput":"a0","EditWindow":""},{"attrCap":"Var 1 increment","attrInput":"parent.dac","EditWindow":""}],"AttributeCount":5}
