6,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"local function RenderArrow(objA, objB, width, color, totalLength, headLength, headAngle, headPosition)  \r\n    -- 计算基础参数  \r\n    local dx = objB.x - objA.x  \r\n    local dy = objB.y - objA.y  \r\n    local angle = math.atan2(dy, dx)  \r\n    local headAngleRad = headAngle * math.pi / 180  \r\n      \r\n    local endX = objA.x + totalLength * math.cos(angle)  \r\n    local endY = objA.y + totalLength * math.sin(angle)  \r\n    local headX = objA.x + totalLength * headPosition * math.cos(angle)  \r\n    local headY = objA.y + totalLength * headPosition * math.sin(angle)  \r\n      \r\n    -- 处理颜色  \r\n    local lstgColor  \r\n    if type(color) == \"userdata\" then  \r\n        lstgColor = color  \r\n    elseif type(color) == \"table\" and #color >= 4 then  \r\n        lstgColor = lstg.Color(color[1], color[2], color[3], color[4])  \r\n    elseif type(color) == \"number\" then  \r\n        lstgColor = lstg.Color(color)  \r\n    else  \r\n        lstgColor = lstg.Color(255, 255, 255, 255)  \r\n    end  \r\n      \r\n    -- 减小整体尺寸，适合自机周围显示  \r\n    local scaleDown = 0.6  -- 缩放因子  \r\n    width = width * scaleDown  \r\n    headLength = headLength * scaleDown  \r\n      \r\n    -- 绘制箭头主体（单次渲染，避免重叠）  \r\n    lstg.SetImageState('white', 'mul+alpha', lstgColor)  \r\n      \r\n    -- 使用更少的分段，减少重叠机会  \r\n    local segments = 4  \r\n    for i = 0, segments - 1 do  \r\n        local t1 = i / segments  \r\n        local t2 = (i + 1) / segments  \r\n          \r\n        local x1 = objA.x + totalLength * t1 * math.cos(angle)  \r\n        local y1 = objA.y + totalLength * t1 * math.sin(angle)  \r\n        local x2 = objA.x + totalLength * t2 * math.cos(angle)  \r\n        local y2 = objA.y + totalLength * t2 * math.sin(angle)  \r\n          \r\n        -- 更温和的渐变宽度：从 0.5 倍到 1.0 倍  \r\n        local width1 = width * (0.5 + t1 * 0.5)  \r\n        local width2 = width * (0.5 + t2 * 0.5)  \r\n          \r\n        local perpX1 = -math.sin(angle) * width1 / 2  \r\n        local perpY1 = math.cos(angle) * width1 / 2  \r\n        local perpX2 = -math.sin(angle) * width2 / 2  \r\n        local perpY2 = math.cos(angle) * width2 / 2  \r\n          \r\n        lstg.Render4V('white',  \r\n            x1 + perpX1, y1 + perpY1, 0,  \r\n            x2 + perpX2, y2 + perpY2, 0,  \r\n            x2 - perpX2, y2 - perpY2, 0,  \r\n            x1 - perpX1, y1 - perpY1, 0  \r\n        )  \r\n    end  \r\n      \r\n    -- 绘制箭头头部（单次渲染）  \r\n    local leftAngle = angle - headAngleRad / 2  \r\n    local rightAngle = angle + headAngleRad / 2  \r\n    local leftEndX = headX + headLength * math.cos(leftAngle)  \r\n    local leftEndY = headY + headLength * math.sin(leftAngle)  \r\n    local rightEndX = headX + headLength * math.cos(rightAngle)  \r\n    local rightEndY = headY + headLength * math.sin(rightAngle)  \r\n      \r\n    -- 简化的箭头头部，避免重叠  \r\n    lstg.Render4V('white',  \r\n        headX, headY, 0,  \r\n        leftEndX, leftEndY, 0,  \r\n        rightEndX, rightEndY, 0,  \r\n        headX, headY, 0  \r\n    )  \r\n      \r\n    -- 轻微的发光效果（减少强度，避免重叠明显）  \r\n    lstg.SetImageState('white', 'add+alpha', lstg.Color(lstgColor.a * 0.15, lstgColor.r, lstgColor.g, lstgColor.b))  \r\n      \r\n    -- 只在箭头头部添加轻微发光  \r\n    lstg.Render4V('white',  \r\n        headX, headY, 0,  \r\n        leftEndX, leftEndY, 0,  \r\n        rightEndX, rightEndY, 0,  \r\n        headX, headY, 0  \r\n    )  \r\nend\r\nlocal sx, sy = lstg.player.gx*100, lstg.player.gy*100\r\nlocal len = math.sqrt(sx*sx+sy*sy)\r\nlocal A = 255\r\nlocal R, G, B = 255,0,0\r\nlocal w = 5\r\nlocal hlen = 15\r\nlocal tmp = {}\r\ntmp.x = lstg.player.x+sx\r\ntmp.y = lstg.player.y+sy\r\nlen = len\r\nif (math.abs(len)>1) then\r\n\tRenderArrow(tmp, lstg.player, w, {A, R, G, B}, len, hlen, 37, 0.0)\r\nend","EditWindow":"code"}],"AttributeCount":1}
