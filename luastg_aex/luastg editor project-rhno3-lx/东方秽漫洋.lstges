3,{"$type":".Object.ObjectInit, ","Attributes":[{"attrCap":"Parameter List","attrInput":"size","EditWindow":""},{"attrCap":"Image","attrInput":"\"ani:fish1\"","EditWindow":"objimage"},{"attrCap":"Layer","attrInput":"LAYER_ENEMY","EditWindow":"layer"},{"attrCap":"Group","attrInput":"GROUP_FOOD","EditWindow":"group"},{"attrCap":"Hide","attrInput":"false","EditWindow":"bool"},{"attrCap":"Bound","attrInput":"true","EditWindow":"bool"},{"attrCap":"Auto Rotation","attrInput":"false","EditWindow":"bool"},{"attrCap":"HP","attrInput":"75","EditWindow":""},{"attrCap":"Collision","attrInput":"true","EditWindow":"bool"}],"AttributeCount":9,"IsExpanded":false}
4,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"--self.gravity = gravity\r\nself.sz=EnemySizeTable[size]\r\n\r\nself.EatPowerBonus=size*2\r\nself.EatLifePenality=25\r\nself.EatLightBonus=self.sz*1.3+25\r\n\r\nlocal sc=self.sz/20 ---根据图片中物体的实际大小来决定\r\nself.hscale=sc\r\nself.vscale=sc\r\nself.a=self.sz\r\nself.b=self.sz\r\nself.navi=true\r\nself.rot=ran:Float(0,360)\r\n\r\nself.LightRange=self.sz*2.2\r\n\r\nself.co=FishColor.Red\r\nself.eaten=true\r\n\r\nself.eatflag=false","EditWindow":"code"}],"AttributeCount":1}
4,{"$type":".Object.CreateObject, ","Attributes":[{"attrCap":"Name","attrInput":"\"EatCollider\"","EditWindow":"objectDef"},{"attrCap":"Position","attrInput":"self.x,self.y","EditWindow":"position"},{"attrCap":"Parameters","attrInput":"","EditWindow":"objectParam"}],"AttributeCount":3}
4,{"$type":".Object.SetBinding, ","Attributes":[{"attrCap":"Master","attrInput":"self","EditWindow":"target"},{"attrCap":"Servant","attrInput":"last","EditWindow":"target"},{"attrCap":"Damage transfer rate","attrInput":"0","EditWindow":""},{"attrCap":"Connect death","attrInput":"true","EditWindow":"bool"}],"AttributeCount":4}
4,{"$type":".Object.SetBlend, ","Attributes":[{"attrCap":"Target","attrInput":"self","EditWindow":"target"},{"attrCap":"Blend Mode","attrInput":"\"mul+add\"","EditWindow":"blend"},{"attrCap":"ARGB","attrInput":"255,self.co[1],self.co[2],self.co[3]","EditWindow":"ARGB"}],"AttributeCount":3}
4,{"$type":".Object.SetBlend, ","Attributes":[{"attrCap":"Target","attrInput":"last","EditWindow":"target"},{"attrCap":"Blend Mode","attrInput":"\"mul+add\"","EditWindow":"blend"},{"attrCap":"ARGB","attrInput":"30,self.co[1],self.co[2],self.co[3]","EditWindow":"ARGB"}],"AttributeCount":3}
4,{"$type":".Task.TaskNode, ","Attributes":[],"IsBanned":true}
5,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.gx = 0\r\nself.gy = 0\r\nwhile object.status ~= \"kill\" do\r\n\tlstg.player.gx = lstg.player.gx - self.gx\r\n\tlstg.player.gy = lstg.player.gy - self.gy\r\n\tlocal dis = lstg.Dist(lstg.player, self)\r\n\tif lstg.player.protect == 0 and dis < lstg.player.gravity_circle_size then\r\n\t\tself.gx = (self.x-lstg.player.x)/dis*self.gravity\r\n\t\tself.gy = (self.y-lstg.player.y)/dis*self.gravity\r\n\telse\r\n\t\tself.gx = 0\r\n\t\tself.gy = 0\r\n\tend\r\n\tlstg.player.gx = lstg.player.gx + self.gx\r\n\tlstg.player.gy = lstg.player.gy + self.gy\r\n\ttask._Wait(1)\r\nend","EditWindow":"code"}],"AttributeCount":1,"IsExpanded":false,"IsBanned":true}
