7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"local ed=ran:Int(1,3)\r\ned=0\r\nlocal neighbor={}\r\nfor i=1,#self.objs do\r\n\tneighbor[i]={}\r\nend\r\n\r\nlocal function difference(t1, t2)\r\n\tlocal result = {}\r\n\tlocal set = {}\r\n\tfor _, v in ipairs(t2) do\r\n\t\tset[v] = true\r\n\tend\r\n\tfor _, v in ipairs(t1) do\r\n\t\tif not set[v] then\r\n\t\t\ttable.insert(result, v)\r\n\t\tend\r\n\tend\r\n\treturn result\r\nend","EditWindow":"code"}],"AttributeCount":1,"IsExpanded":false}
