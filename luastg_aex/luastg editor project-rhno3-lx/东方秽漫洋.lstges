7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"local ori_a=(Angle(self.p,self)+360)%360\r\nlocal dest_a=(a0+360)%360\r\nlocal ori_r=Dist(self.p,self)\r\n\r\nif abs(ori_a-dest_a)>180 then\r\n\tif ori_a>dest_a then dest_a=dest_a+360 else dest_a=dest_a-360\r\n\tend\r\nend","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"local dest_r=self.p.dest_r","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".General.Repeat, LuaSTGEditorSharp","Attributes":[{"attrCap":"Times","attrInput":"180","EditWindow":"yield"},{"$type":".DependencyAttrItem, ","attrCap":"Number of Var","attrInput":"1","EditWindow":""},{"attrCap":"Var 1 name","attrInput":"l","EditWindow":""},{"attrCap":"Var 1 init value","attrInput":"0","EditWindow":""},{"attrCap":"Var 1 increment","attrInput":"1/180","EditWindow":""}],"AttributeCount":5}
