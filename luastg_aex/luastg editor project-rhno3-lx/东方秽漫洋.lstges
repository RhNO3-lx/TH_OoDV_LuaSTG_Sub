6,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"local function red() return Color(255,255,190,220) end\r\nlocal function purple() return Color(255,230,190,255) end\r\ndialog=New(DialogDisplayer,{\r\n{text=\"完了呀老师，这个代码会涨潮的哦\",color=red()},\r\n{text=\"诶？\",func=function(obj)\r\ndial:AddChara(obj,\"renseki\",\"image:renseki-think2\",{x=100,y=200},0.25)\r\nend},\r\n{text=\"又退潮啦\",color=red(),func=function(obj)\r\ndial:SetCharaState(obj,\"renseki\",false)\r\nend},\r\n{text=\"老师救命啊，堆栈溢出了啊，爆辣！这个污秽炸出来啦\\n丰姬老师这个污秽炸出来了哇，爆出来了哇老师\",color=red()},\r\n{text=\"你们就这样让他只管收集信息，一股脑地吸收\\n没有任何的溢出保护措施吗？\",func=function(obj)\r\ndial:SetCharaState(obj,\"renseki\",\"active\")\r\ndial:AddChara(obj,\"renseki\",\"image:renseki-wordless\",{x=100,y=200},0.25)\r\nend},\r\n{text=\"不过所幸刚才丢掉的信息也不多，大多也是那些杂乱无章的东西\\n倒还好\",func=function(obj)\r\ndial:AddChara(obj,\"renseki\",\"image:renseki-smile\",{x=100,y=200},0.25)\r\nend},\r\n{text=\"维缦，你刚才说有人把咱的服务器搞炸了？\",color=purple(),func=function(obj)\r\ndial:SetCharaState(obj,\"renseki\",false)\r\nend},\r\n{text=\"诶？\",func=function(obj)\r\ndial:SetCharaState(obj,\"renseki\",\"active\")\r\ndial:AddChara(obj,\"renseki\",\"image:renseki-think\",{x=100,y=200},0.25)\r\nend}\r\n})","EditWindow":"code"}],"AttributeCount":1}
