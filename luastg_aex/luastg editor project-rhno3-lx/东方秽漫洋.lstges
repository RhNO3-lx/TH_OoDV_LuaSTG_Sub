7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"local cx,cy=tar.x,tar.y\r\nself.tar=tar\r\nlocal tx,ty=-60*sign+ran:Int(-8,8),80+ran:Int(-8,8)\r\nlocal route={sign*150+cx,ran:Float(-5,5)+130+cy,\r\n\t\t\tsign*(40)+ran:Float(-6,6)+cx,-90+ran:Float(-6,6)+cy,\r\n\t\t\tsign*(-310)+cx,-140+ran:Int(-5,5)+cy,\r\n\t\t\tsign*(-100)+cx,40+ran:Int(-5,5)+cy,\r\n\t\t\tsign*90+cy,240+cy}\r\n\r\nself.x,self.y=tx+cx,ty+cy","EditWindow":"code"}],"AttributeCount":1,"IsBanned":true}
