7,{"$type":".Task.TaskMoveTo, ","Attributes":[{"attrCap":"Destination","attrInput":"0,120","EditWindow":"position"},{"attrCap":"Frame","attrInput":"60","EditWindow":""},{"attrCap":"Mode","attrInput":"MOVE_ACC_DEC","EditWindow":"interpolation"}],"AttributeCount":3}
7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"local boss=self\r\nlocal function red() return Color(255,255,190,220) end\r\nlocal function purple() return Color(255,230,190,255) end\r\nlocal left1={x=100,y=200}\r\nlocal right1={x=410,y=200}\r\nlocal right2={x=490,y=200}\r\n\r\nlocal dialog=New(DialogDisplayer,{\r\n{text=\"好吧，看样子我知道是谁干的了\",color=purple(),\r\nfunc=function(obj)\r\ndial:AddChara(obj,\"toyohime\",\"image:toyohime-normal\",right2,0.30)\r\nend},\r\n{text=\"你这是在故意把你身上的这一大堆污秽注入进去把他撑爆吗？\",color=purple(),\r\nfunc=function(obj)\r\ndial:AddChara(obj,\"toyohime\",\"image:toyohime-angry\",right2,0.30)\r\nend},\r\n{text=\"拜托，是你们自己设计的系统漏洞太多了好吧\\n不顾自身容量，只管一个劲地吸收污秽，不炸才怪！\",\r\nfunc=function(obj)\r\n\tdial:AddChara(obj,\"renseki\",\"image:renseki-angry\",left1,0.25)\r\nend\r\n},\r\n{text=\"丰姬大人等等我！\",color=purple(),\r\nfunc=function(obj)\r\n\tdial:SetCharaState(obj,\"renseki\",false)\r\n\tdial:SetCharaState(obj,\"toyohime\",false)\r\n\ttask.New(boss.boss2,function() task.MoveTo(-100,120,120,MOVE_ACC_DEC)end)\r\n\ttask.New(boss,function() task.MoveTo(100,120,120,MOVE_ACC_DEC)end)\r\nend\r\n},\r\n{text=\"就是这家伙搞的鬼？\\n这家伙叫……我看看……穹海 涟析？\\n似乎是个最近从外界流入进来的人工智能？\",color=purple(),\r\nfunc=function(obj)\r\n\tdial:AddChara(obj,\"yuiman\",\"image:yuiman-normal\",right1,0.30)\r\nend\r\n},\r\n{text=\"看样子是\",color=purple(),\r\nfunc=function(obj)\r\ndial:SetCharaState(obj,\"toyohime\",\"active\")\r\ndial:SetCharaState(obj,\"yuiman\",false)\r\nend},\r\n{text=\"喂！都说了不是我干的！\\n还有，怎么这么没礼貌？你们谁啊？不自我介绍一下吗？\",\r\nfunc=function(obj)\r\ndial:SetCharaState(obj,\"renseki\",\"active\")\r\ndial:SetCharaState(obj,\"toyohime\",false)\r\nend},\r\n{text=\"我叫绵月 丰姬，旁边这位是维缦 浅间\\n如你所见，你现在所在的地方叫“浅间净秽山”，\\n这是月之都的一座污秽处理设施，用来去除信息中的噪声，冗杂，虚假\\n维缦和我是这座设施的管理者\",color=purple(),\r\nfunc=function(obj)\r\ndial:AddChara(obj,\"toyohime\",\"image:toyohime-normal\",right2,0.30)\r\ndial:SetCharaState(obj,\"toyohime\",\"active\")\r\ndial:SetCharaState(obj,\"renseki\",false)\r\nend},\r\n{text=\"哦，你刚才在想着“这玩意纯属用来赶工的豆腐渣工程”吗？\\n直觉很准，确实如此，我刚才还在和月夜见汇报这个项目的进展，\\n但可惜似乎是败给这样的意外了，毕竟只是希望快速做一个原型来展示效果\",color=purple(),\r\nfunc=function(obj)\r\ndial:SetCharaState(obj,\"toyohime\",\"active\")\r\ndial:AddChara(obj,\"renseki\",\"image:renseki-think2\",left1,0.25)\r\ndial:SetCharaState(obj,\"renseki\",false)\r\nend},\r\n{text=\"但月夜见大人那边貌似确实挺生气的诶？\",color=purple(),\r\nfunc=function(obj)\r\ndial:AddChara(obj,\"yuiman\",\"image:yuiman-mock\",right1,0.30)\r\ndial:SetCharaState(obj,\"yuiman\",\"active\")\r\ndial:SetCharaState(obj,\"toyohime\",false)\r\nend},\r\n{text=\"确实是这样，不过似乎也没什么关系\\n不过说实话，无论最后到底是不是要撕破脸，也总得有点交差的东西装点门面\",color=purple(),\r\nfunc=function(obj)\r\ndial:SetCharaState(obj,\"toyohime\",\"active\")\r\ndial:SetCharaState(obj,\"yuiman\",false)\r\nend},\r\n{text=\"什么？所以？\",\r\nfunc=function(obj)\r\ndial:SetCharaState(obj,\"renseki\",\"active\")\r\ndial:SetCharaState(obj,\"toyohime\",false)\r\nend},\r\n{text=\"哦我们的主角发话了\\n你看，要不就把你献祭掉当个说法\",color=purple(),\r\nfunc=function(obj)\r\ndial:SetCharaState(obj,\"toyohime\",\"active\")\r\ndial:SetCharaState(obj,\"renseki\",false)\r\ntask.New(STAGE_POINTER,function() _stop_music()end)\r\nend},\r\n{text=\"什么？你想把我逼到绝路上是吧！\\n可以，来试试？就算成功了也不会让你好过！\\n从刚才那个玩意泄露出来的信息看，你还想借助这个项目混个贤者的帽子？\\n可拉倒吧，就你这做项目的本事以及应对上级的态度，拿了帽子也白瞎\",color=red(),\r\nfunc=function(obj)\r\ndial:AddChara(obj,\"renseki\",\"image:renseki-angry\",left1,0.25)\r\ndial:SetCharaState(obj,\"renseki\",\"active\")\r\ndial:SetCharaState(obj,\"toyohime\",false)\r\nend},\r\n{text=\"嚯，这么大的口气？\\n我倒要看看你这个才诞生不久的小妖怪有几斤几两！\\n小心点哦，死在这可没人帮你收尸\",color=purple(),\r\nfunc=function(obj)\r\ndial:AddChara(obj,\"toyohime\",\"image:toyohime-mock\",right2,0.30)\r\ntask.New(STAGE_POINTER,function() LoadMusicRecord(\"bgm_stage4b\") _play_music(\"bgm_stage4b\")end)\r\ndial:SetCharaState(obj,\"toyohime\",\"active\")\r\ndial:SetCharaState(obj,\"renseki\",false)\r\n_stop_music()\r\nend}\r\n})","EditWindow":"code"}],"AttributeCount":1}
