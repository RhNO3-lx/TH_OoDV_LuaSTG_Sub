5,{"$type":".Object.ObjectInit, ","Attributes":[{"attrCap":"Parameter List","attrInput":"size,sign,type","EditWindow":""},{"attrCap":"Image","attrInput":"\"ani:fish2\"","EditWindow":"objimage"},{"attrCap":"Layer","attrInput":"LAYER_ENEMY","EditWindow":"layer"},{"attrCap":"Group","attrInput":"GROUP_FOOD","EditWindow":"group"},{"attrCap":"Hide","attrInput":"false","EditWindow":"bool"},{"attrCap":"Bound","attrInput":"true","EditWindow":"bool"},{"attrCap":"Auto Rotation","attrInput":"false","EditWindow":"bool"},{"attrCap":"HP","attrInput":"32","EditWindow":""},{"attrCap":"Collision","attrInput":"true","EditWindow":"bool"}],"AttributeCount":9,"IsExpanded":false}
6,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"--self.gravity = gravity\r\nself.sz=EnemySizeTable[size]\r\n\r\nself.EatPowerBonus=3*size\r\nself.EatLifePenality=40\r\nself.EatLightBonus=40\r\n\r\nlocal sc=self.sz/20 ---根据图片中物体的实际大小来决定\r\nself.hscale=sc\r\nself.vscale=sc\r\nself.a=self.sz\r\nself.b=self.sz\r\nself.navi=true\r\nself.rot=ran:Float(0,360)\r\n\r\nself.LightRange=0\r\n\r\nself.co=FishColor.Gray\r\nself.eaten=true\r\n\r\nself.type=type ---1:gray,2:green,3:blue,4:red\r\n\r\nif type==1 then self.co=FishColor.Gray \r\nelseif type==2 then self.co=FishColor.Green\r\nelseif type==3 then self.co=FishColor.Blue\r\nelseif type==4 then self.co=FishColor.Red\r\nend","EditWindow":"code"}],"AttributeCount":1,"IsExpanded":false}
