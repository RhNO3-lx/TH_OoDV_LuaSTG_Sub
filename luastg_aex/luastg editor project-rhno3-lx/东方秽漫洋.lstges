9,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"local p=self.anchor\r\nif not IsValid(p) then break end\r\nlocal r=self.r0*p.ratio\r\nlocal a=self.a0+p.rot\r\nlocal dx=r*cos(a)\r\nlocal dy=r*sin(a)\r\nself.x,self.y=p.x+dx,p.y+dy","EditWindow":"code"}],"AttributeCount":1}
