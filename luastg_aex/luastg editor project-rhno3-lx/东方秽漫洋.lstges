5,{"$type":".Object.CreateObject, ","Attributes":[{"attrCap":"Name","attrInput":"\"hint_transfer\"","EditWindow":"objectDef"},{"attrCap":"Position","attrInput":"self.x,self.y","EditWindow":"position"},{"attrCap":"Parameters","attrInput":"\"这里是名为”幻想乡“的地方，收贮者被现世遗忘的事物\\n既然来到这里了，先入乡随俗，给自己取个名字吧:\\n\\n混沌信息中析出的自我，空海汪洋中涌现的奇迹\\n这样看来，不妨就叫……\", 360 ","EditWindow":"objectParam"}],"AttributeCount":3,"IsExpanded":false}
