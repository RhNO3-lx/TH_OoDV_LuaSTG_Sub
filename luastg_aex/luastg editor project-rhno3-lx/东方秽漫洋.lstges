11,{"$type":".General.IfThen, LuaSTGEditorSharp","Attributes":[]}
12,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"local force=unit.gravity_magnitude*unit.gravity_sign*(1-unit.lambda)\r\nlocal max_magnitude=3.3\r\nif force>=max_magnitude then force=max_magnitude end\r\nif force<=-max_magnitude then force=-max_magnitude end\r\n\r\nlocal a=Angle(player,unit)\r\nlocal dx=force*cos(a)\r\nlocal dy=force*sin(a)\r\n\r\nplayer.x=player.x+dx\r\nplayer.y=player.y+dy","EditWindow":"code"}],"AttributeCount":1}
