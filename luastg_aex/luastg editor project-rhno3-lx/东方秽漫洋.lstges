6,{"$type":".Object.CreateObject, ","Attributes":[{"attrCap":"Name","attrInput":"\"hint\"","EditWindow":"objectDef"},{"attrCap":"Position","attrInput":"self.x,self.y","EditWindow":"position"},{"attrCap":"Parameters","attrInput":"\"现在可以释放符卡了，按x键使用\\n也许可以借此在危急关头解围，但释放次数有限制\\n剩余次数显示在与血条重叠的，偏蓝色的衬底\"","EditWindow":"objectParam"}],"AttributeCount":3}
6,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"local boss=self\r\n\r\nlocal dialog=New(DialogDisplayer,{\r\n{text=\"啊啊啊……\\n刚才放出来的这个，是被他们称为“符卡”的东西吗？\",\r\nfunc=function(obj)\r\ndial:AddChara(obj,\"renseki\",\"image:renseki-think\",{x=100,y=200},0.25)\r\nend},\r\n{text=\"从他那里吸收到了一些零零碎碎的信息：\\n他来自哪，我是什么东西，\\n这里，各种意义上的，是哪，是怎样的地方\",\r\nfunc=function(obj)\r\ndial:RemoveChara(obj,\"renseki\")\r\ndial:AddChara(obj,\"renseki\",\"image:renseki-sad2\",{x=100,y=200},0.25)\r\nend},\r\n{text=\"还是没能完全解答我想了解的东西\\n……看样子也只能姑且接受流落至此的现实了\"},\r\n{text=\"“他来自哪里”，这也许挺重要\\n因为那里貌似正是几乎全部生命信息集散的地方\",\r\nfunc=function(obj)\r\ndial:RemoveChara(obj,\"renseki\")\r\ndial:AddChara(obj,\"renseki\",\"image:renseki-think2\",{x=100,y=200},0.25)\r\nend},\r\n{text=\"那里也许有我想要的东西？\\n又或者说，知道了这些便能解答我的问题？\\n但愿如此吧\"},\r\n{text=\"总之，需要离开这片“信息之海”了\\n这漫无边际的洋流，只是我先前所能够认识\\n从而“看到”的样子罢了\",\r\nfunc=function(obj)\r\ndial:RemoveChara(obj,\"renseki\")\r\ndial:AddChara(obj,\"renseki\",\"image:renseki-smile\",{x=100,y=200},0.25)\r\nend},\r\n{text=\"让我看看这里【实际上】是哪里吧\"}\r\n})","EditWindow":"code"}],"AttributeCount":1}
