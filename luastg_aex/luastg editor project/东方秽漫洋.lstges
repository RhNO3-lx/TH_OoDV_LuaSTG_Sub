3,{"$type":".Object.ObjectInit, ","Attributes":[{"attrCap":"Parameter List","attrInput":"omiga","EditWindow":""},{"attrCap":"Image","attrInput":"\"white\"","EditWindow":"objimage"},{"attrCap":"Layer","attrInput":"LAYER_ENEMY_BULLET","EditWindow":"layer"},{"attrCap":"Group","attrInput":"GROUP_ENEMY_BULLET","EditWindow":"group"},{"attrCap":"Hide","attrInput":"false","EditWindow":"bool"},{"attrCap":"Bound","attrInput":"true","EditWindow":"bool"},{"attrCap":"Auto Rotation","attrInput":"false","EditWindow":"bool"},{"attrCap":"HP","attrInput":"10","EditWindow":""},{"attrCap":"Collision","attrInput":"true","EditWindow":"bool"}],"AttributeCount":9}
4,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"local A = 0.05\r\nlocal B = 20\r\nself.group = GROUP_PLAYER_EAT\r\nself.colli = true\r\nself.omiga = omiga\r\nfunction CalcSize(power)\r\n\tif power < 100 then\r\n\t\tans = power/10+10\r\n\telseif power < 200 then\r\n\t\tans = power/10+20\r\n\telseif power < 300 then\r\n\t\tans = power/10+30\r\n\telseif power < 400 then\r\n\t\tans = power/10+40\r\n\telse\r\n\t\tans = 90\r\n\tend\r\n\treturn ans\r\nend\r\nself.a = CalcSize(lstg.var.power)\r\nself.support = self.size","EditWindow":"code"}],"AttributeCount":1}
4,{"$type":".Task.TaskNode, ","Attributes":[]}
5,{"$type":".General.Repeat, LuaSTGEditorSharp","Attributes":[{"attrCap":"Times","attrInput":"_infinite","EditWindow":"yield"},{"$type":".DependencyAttrItem, ","attrCap":"Number of Var","attrInput":"1","EditWindow":""},{"attrCap":"Var 1 name","attrInput":"","EditWindow":""},{"attrCap":"Var 1 init value","attrInput":"","EditWindow":""},{"attrCap":"Var 1 increment","attrInput":"","EditWindow":""}],"AttributeCount":5}
6,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.support = CalcSize(lstg.var.power)\r\nif self.a < self.support then\r\n\tself.a = self.a + 1\r\nelseif self.a > self.support then\r\n\tself.a = self.a - 1\r\nend\r\nself.b = self.a\r\nself.x = lstg.player.x\r\nself.y = lstg.player.y","EditWindow":"code"}],"AttributeCount":1}
